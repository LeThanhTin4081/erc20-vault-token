{
  "name": "blockchain",
  "version": "1.0.0",
  "description": "Hardhat 3 workspace for VaultToken development and Sepolia deployment.",
  "scripts": {
    "clean": "npx hardhat clean",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy:local": "npx hardhat ignition deploy ./ignition/modules/DeploySystem.ts --network localhost",
    "deploy:local:reset": "npx hardhat ignition deploy ./ignition/modules/DeploySystem.ts --network localhost --reset",
    "setup:local": "npx hardhat run scripts/setupAdmin.ts --network localhost",
    "deploy:sepolia": "npx hardhat ignition deploy ./ignition/modules/DeploySystem.ts --network sepolia"
  },
  "keywords": [],
  "author": "",
