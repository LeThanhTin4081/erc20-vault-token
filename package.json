{
  "name": "blockchain",
  "version": "1.0.0",
  "description": "Hardhat 3 workspace for VaultToken development and Sepolia deployment.",
  "scripts": {
    "clean": "npx hardhat clean",
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "node": "npx hardhat node",
    "deploy:local": "npx hardhat run scripts/deploy.ts --network hardhatMainnet --no-compile",
    "deploy:ignition:local": "npx hardhat ignition deploy ./ignition/modules/Token.ts --network hardhatMainnet",
    "deploy:sepolia": "npx hardhat run scripts/deploy.ts --network sepolia",
    "deploy:ignition:sepolia": "npx hardhat ignition deploy ./ignition/modules/Token.ts --network sepolia",
    "check:sepolia": "npx hardhat run scripts/check-sepolia.ts --network sepolia --no-compile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.8",
    "@nomicfoundation/hardhat-ignition": "^3.1.1",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@types/node": "^22.19.17",
    "hardhat": "^3.3.0",
    "typescript": "~5.8.0",
    "viem": "^2.47.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
