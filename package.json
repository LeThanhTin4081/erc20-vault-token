    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.3",
    "@types/chai": "^5.2.3",
    "@types/node": "^22.19.17",
    "chai": "^6.2.2",
    "hardhat": "^3.3.0",
    "typescript": "~5.8.0",
    "viem": "^2.47.10"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
